{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autaksing-resume",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "VIDEOS",
      "bucket_name": "autaksing-videos"
    }
  ],
  "ratelimits": [
    {
      "name": "ADMIN_LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
